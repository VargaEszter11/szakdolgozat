DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=szakdolgozat

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Test: https://test.api.amadeus.com — Airport Nearest / City Search only cover US, ES, UK, DE, IN (Hungary etc. may 500).
# Production: https://api.amadeus.com with production app keys.
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Trip planning LLM (default: DeepSeek cloud). Optional: DEFAULT_LLM_PROVIDER=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Local Ollama (when user selects "Local Ollama" in Settings)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:4b

# OpenStreetMap Nominatim (geocoding). Required: unique User-Agent with contact per OSM policy.
# Example: NOMINATIM_USER_AGENT=TravelApp/1.0 (your-name thesis; your.email@university.edu)
NOMINATIM_USER_AGENT=

# HTTP logging: inbound /api and /generate_* are logged at INFO. Set to 1 to log every path (static files too).
LOG_ALL_HTTP=
