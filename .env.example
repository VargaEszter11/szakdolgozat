# Used both for local dev and by docker-compose.yml (which maps these onto the
# "db" service's POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB, and overrides
# DB_HOST/DB_PORT to point the backend container at "db:5432" automatically).
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=szakdolgozat

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AirLabs aviation data import (airports, airlines, routes)
AIRLABS_API_KEY=
AIRLABS_BASE_URL=https://airlabs.co/api/v9

# Trip planning LLM (DeepSeek cloud — required for trip generation)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenStreetMap Nominatim (geocoding). Required: unique User-Agent with contact per OSM policy.
# Example: NOMINATIM_USER_AGENT=Planventure/1.0 (your-name thesis; your.email@university.edu)
NOMINATIM_USER_AGENT=

# HTTP logging: inbound /api and /generate_* are logged at INFO. Set to 1 to log every path (static files too).
LOG_ALL_HTTP=

# SMTP for transactional email (password reset links). Required for /forgot-password/request.
# Example (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<app password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Base URL used to build links in emails (e.g. password reset). Defaults to the
# request's own origin if unset; only needed behind a reverse proxy that changes the host.
# REQUIRED when deployed via docker-compose/Coolify: the backend only sees requests
# from the "frontend" nginx container internally, so without this set explicitly,
# reset-password links would embed the internal Docker hostname instead of your
# real public domain. Set to e.g. https://planventure.yourdomain.com
PUBLIC_BASE_URL=

# Shared secret for the admin data export/import page (/pages/admin/admin.html),
# used to migrate data between environments (e.g. local -> production). Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to disable admin access entirely (the endpoints return 503).
ADMIN_SECRET=

# JWT signing secret for user access tokens (login / Google login).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a fixed development fallback is used (not for production).
JWT_SECRET=
